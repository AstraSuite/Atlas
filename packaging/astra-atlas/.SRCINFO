pkgbase = astra-atlas
	pkgdesc = Fast, lightweight Material Design 3 file manager
	pkgver = 1.4.0
	pkgrel = 1
	url = https://github.com/AstraSuite/Atlas
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-only
	makedepends = cargo
	depends = gcc-libs
	depends = glibc
	depends = qt6-base
	depends = qt6-declarative
	depends = qt6-multimedia
	depends = qt6-svg
	optdepends = caelestia-cli: dynamic color scheme syncing with Caelestia
	optdepends = exiv2: editing the EXIF comment of a photo
	optdepends = ffmpeg: integrated video and audio manipulation
	optdepends = gvfs: remote network filesystem mounting
	optdepends = git: inline repository status and branch tracking
	optdepends = imagemagick: integrated image conversion and manipulation
	optdepends = papirus-folders: dynamic folder color
	optdepends = papirus-icon-theme: dynamic folder color
	optdepends = udisks2: external drive management
	optdepends = xdg-desktop-portal: desktop portal integration
	optdepends = xdg-utils: default application launching
	optdepends = bzip2: archive extraction and compression
	optdepends = gzip: archive extraction and compression
	optdepends = p7zip: archive extraction and compression
	optdepends = tar: archive extraction and compression
	optdepends = unzip: archive extraction and compression
	optdepends = xz: archive extraction and compression
	optdepends = zip: archive extraction and compression
	conflicts = astra-atlas-bin
	conflicts = astra-atlas-git
	options = !lto
	source = https://github.com/AstraSuite/Atlas/releases/download/v1.4.0/astra-atlas-1.4.0.tar.gz
	sha256sums = SKIP

pkgname = astra-atlas
